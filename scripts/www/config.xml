<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" 
        xmlns:cdv="http://cordova.apache.org/ns/1.0" 
        id="com.sumoo.planlist" 
        version="1.0.0">
    
    <name>Sumoo's Plan List</name>
    <description>多维度计划清单管理应用</description>
    <author email="support@sumoo.com" href="https://sumoo.com">Sumoo</author>
    
    <content src="isolated-data-index.html" />
    
    <access origin="*" />
    
    <preference name="DisallowOverscroll" value="true" />
    <preference name="android-minSdkVersion" value="19" />
    <preference name="Orientation" value="portrait" />
    
    <platform name="android">
        <icon src="res/icon/android/icon-36-ldpi.png" density="ldpi" />
        <icon src="res/icon/android/icon-48-mdpi.png" density="mdpi" />
        <icon src="res/icon/android/icon-72-hdpi.png" density="hdpi" />
        <icon src="res/icon/android/icon-96-xhdpi.png" density="xhdpi" />
    </platform>
    
</widget>